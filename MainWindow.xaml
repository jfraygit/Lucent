<Window x:Class="Lucent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Lucent.Ui"
        Title="Lucent" Height="900" Width="1500"
        Icon="Assets/logo.ico"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ChromeBg}">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="0,0,0,1"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.InputBindings>
    <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NewTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
    <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
    <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding FocusAddressCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
    <KeyBinding Key="F5" Command="{Binding ReloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
    <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding BookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
    <KeyBinding Key="B" Modifiers="Ctrl+Shift" Command="{Binding ToggleBookmarkBarCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="TabStripRow" Grid.Row="0" Height="40">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" Margin="8,0,0,0"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal">
          <ItemsControl x:Name="TabStrip" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Panel.ZIndex" Value="10"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Background="Transparent" Height="40" Margin="0,0,3,0" Cursor="Hand"
                      MouseLeftButtonDown="Tab_MouseDown"
                      MouseMove="Tab_MouseMove"
                      MouseLeftButtonUp="Tab_MouseUp"
                      LostMouseCapture="Tab_LostCapture">
                <Border x:Name="TabRoot" Background="{StaticResource TabBg}"
                        CornerRadius="7,7,0,0" Padding="11,0,5,0"
                        VerticalAlignment="Bottom"
                        Height="33" MinWidth="130" MaxWidth="220"
                        RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform x:Name="TabScale" ScaleX="1" ScaleY="1"/>
                      <TranslateTransform X="{Binding DragOffset}"/>
                    </TransformGroup>
                  </Border.RenderTransform>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Favicon}" Width="16" Height="16"
                           Margin="0,0,8,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource FgDim}"
                               FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                    <Button Grid.Column="2" Content="&#xE711;" FontSize="9"
                            Width="21" Height="21" Style="{StaticResource IconButton}"
                            Click="TabClose_Click" ToolTip="Close Tab"/>
                  </Grid>
                </Border>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource TabActiveBg}"/>
                    <Setter TargetName="TabRoot" Property="Height" Value="34"/>
                  </DataTrigger>

                  <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource TabActiveBg}"/>
                    <Setter TargetName="TabRoot" Property="Cursor" Value="SizeWE"/>
                    <Setter TargetName="TabRoot" Property="Effect">
                      <Setter.Value>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                                          Opacity="0.55" Color="Black"/>
                      </Setter.Value>
                    </Setter>
                    <DataTrigger.EnterActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleX"
                                           To="1.04" Duration="0:0:0.10"/>
                          <DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleY"
                                           To="1.06" Duration="0:0:0.10"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleX"
                                           To="1" Duration="0:0:0.14"/>
                          <DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleY"
                                           To="1" Duration="0:0:0.14"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </DataTrigger.ExitActions>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="&#xE710;" Style="{StaticResource IconButton}"
                  VerticalAlignment="Top" Margin="2,9,0,0"
                  Click="NewTab_Click" ToolTip="New Tab (Ctrl+T)"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="&#xE921;" Style="{StaticResource WindowButton}"
                Click="Minimize_Click" ToolTip="Minimize"/>
        <Button x:Name="MaximizeButton" Click="Maximize_Click">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
              <Setter Property="Content" Value="&#xE922;"/>
              <Setter Property="ToolTip" Value="Maximize"/>
              <Style.Triggers>
                <DataTrigger Value="Maximized"
                             Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                  <Setter Property="Content" Value="&#xE923;"/>
                  <Setter Property="ToolTip" Value="Restore"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="&#xE8BB;" Style="{StaticResource WindowCloseButton}"
                Click="CloseWindow_Click" ToolTip="Close"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="NavRow" Grid.Row="1" Margin="8,5,8,7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="BackButton" Grid.Column="0" Content="&#xE72B;"
              Style="{StaticResource IconButton}" Click="Back_Click" ToolTip="Back"/>
      <Button x:Name="ForwardButton" Grid.Column="1" Content="&#xE72A;"
              Style="{StaticResource IconButton}" Click="Forward_Click" ToolTip="Forward"/>
      <Button x:Name="ReloadButton" Grid.Column="2" Content="&#xE72C;"
              Style="{StaticResource IconButton}" Click="Reload_Click" ToolTip="Reload (F5)"/>

      <Border Grid.Column="3" Background="{StaticResource FieldBg}" CornerRadius="7"
              Height="30" Margin="6,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBox x:Name="AddressBar" Style="{StaticResource AddressBox}"
                   KeyDown="AddressBar_KeyDown" GotKeyboardFocus="AddressBar_GotFocus"/>

          <Button x:Name="StarButton" Grid.Column="1" Style="{StaticResource StarButton}"
                  Margin="0,0,3,0" Click="Star_Click"/>
        </Grid>
      </Border>

      <Border Grid.Column="4" Background="{StaticResource FieldBg}" CornerRadius="7"
              Padding="10,0,10,0" Height="30" ToolTip="Requests blocked on this tab">
        <TextBlock x:Name="BlockCount" Text="0 blocked" Foreground="{StaticResource FgDim}"
                   FontSize="12" VerticalAlignment="Center"/>
      </Border>

      <TextBlock x:Name="VersionLabel" Grid.Column="5" Foreground="#5C5C66" FontSize="11"
                 VerticalAlignment="Center" Margin="9,0,3,0"/>
    </Grid>

    <ScrollViewer x:Name="BookmarkBarRoot" Grid.Row="2" Visibility="Collapsed"
                  Margin="9,0,8,6" HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="BookmarkBar">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource BookmarkChip}" Click="Bookmark_Click"
                    ToolTip="{Binding Url}">
              <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Image}" Width="16" Height="16" Margin="0,0,7,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                           MaxWidth="150" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button.ContextMenu>
                <ContextMenu Style="{StaticResource ChromeContextMenu}"
                             ui:MenuChrome.Animated="True">
                  <MenuItem Header="Rename Bookmark" Click="BookmarkRename_Click">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xE70F;" FontSize="13" Foreground="{StaticResource FgDim}"
                                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Remove Bookmark" Click="BookmarkRemove_Click">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xE74D;" FontSize="13" Foreground="{StaticResource FgDim}"
                                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border x:Name="UpdateBar" Grid.Row="3" Visibility="Collapsed"
            Background="{StaticResource FieldBg}" CornerRadius="7"
            Margin="8,0,8,7" Padding="12,0,4,0" Height="34">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="UpdateText" Foreground="{StaticResource Fg}" FontSize="12"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

        <Button x:Name="UpdateAction" Grid.Column="1" Content="Install"
                Style="{StaticResource AccentTextButton}" Click="UpdateInstall_Click"/>
        <Button x:Name="UpdateDismiss" Grid.Column="2" Content="Later"
                Style="{StaticResource TextButton}" Click="UpdateLater_Click"/>
      </Grid>
    </Border>

    <Grid x:Name="ContentHost" Grid.Row="4" Margin="4,0,4,4"/>
  </Grid>
</Window>
