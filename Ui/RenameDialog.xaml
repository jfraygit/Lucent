<Window x:Class="Lucent.Ui.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Bookmark"
        Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Border Background="#1F1F26" BorderBrush="#3A3A45" BorderThickness="1"
          CornerRadius="10" Padding="18,16,18,14" Margin="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                        Opacity="0.5" Color="Black"/>
    </Border.Effect>

    <StackPanel>
      <TextBlock Text="Rename Bookmark" Foreground="{StaticResource Fg}"
                 FontSize="13" FontWeight="SemiBold" Margin="0,0,0,3"/>

      <TextBlock x:Name="UrlLabel" Foreground="{StaticResource FgDim}" FontSize="11"
                 TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>

      <Border Background="{StaticResource FieldBg}" CornerRadius="7" Height="32">
        <TextBox x:Name="NameBox" Style="{StaticResource AddressBox}"
                 Height="32" MaxLength="120"/>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="Cancel" Style="{StaticResource TextButton}"
                IsCancel="True" Click="Cancel_Click"/>
        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentTextButton}"
                IsDefault="True" Click="Save_Click" Margin="4,0,0,0"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
