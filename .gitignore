# Build output. Debug and Release are anchored to the repo root deliberately:
# unanchored, [Rr]elease/ also matches tools\release\, which silently kept the whole
# release pipeline out of a commit.
bin/
obj/
/[Dd]ebug/
/[Rr]elease/
artifacts/

# Visual Studio / Rider / VS Code
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
packages/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Note: Assets/logo.png and Assets/logo.ico are generated by tools\make-icon.ps1
# but are committed on purpose -- they are build inputs (ApplicationIcon and the
# window icon), and the source art lives outside this repo.
